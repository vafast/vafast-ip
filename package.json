{
  "name": "@vafast/ip",
  "version": "0.1.0",
  "description": "Get client IP from request headers for Vafast framework",
  "type": "module",
  "author": {
    "name": "Gaurish Sethia",
    "url": "https://github.com/gaurishhs/@vafast/ip",
    "email": "gaurishh.sethia@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gaurishhs/@vafast/ip"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "bugs": "https://github.com/gaurishhs/@vafast/ip/issues",
  "homepage": "https://github.com/gaurishhs/@vafast/ip",
  "keywords": [
    "@vafast",
    "typescript",
    "ip",
    "client-ip"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "npx tsx watch example/basic.ts",
    "test": "npx vitest run",
    "release": "npm run build && npm run test && npx bumpp && npm publish --access=public"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.19.0-beta.4",
    "typescript": "^5.4.5",
    "vafast": "^0.5.1",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "vafast": "^0.5.1"
  }
}
